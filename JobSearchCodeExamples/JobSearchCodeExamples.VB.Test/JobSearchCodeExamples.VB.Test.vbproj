<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>JobSearchCodeExamples.VB.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <Platforms>AnyCPU;x64;x86;ARM32;ARM64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'!='AnyCPU'">
    <OutputPath>..\Build\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='AnyCPU'">
    <OutputPath>..\Build\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\ExecCodeCoverage.ps1" Link="ExecCodeCoverage.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="ReportGenerator" Version="5.5.10" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.analyzers" Version="1.27.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.console" Version="2.9.3" />
    <PackageReference Include="xunit.runner.utility" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JobSearchCodeExamples.VB\JobSearchCodeExamples.vb.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="EmptyFiles" />
    <Import Include="JobSearchCodeExamples.VB" />
    <Import Include="JobSearchCodeExamples.VB.Test.TestTaker" />
    <Import Include="JobSearchCodeExamples.VB.TestTaker" />
    <Import Include="VerifyTests" />
    <Import Include="VerifyXunit" />
    <Import Include="Xunit" />
    <Import Include="Xunit.Abstractions" />
    <Import Include="Xunit.ConsoleClient" />
    <Import Include="Xunit.Extensions" />
  </ItemGroup>

</Project>
